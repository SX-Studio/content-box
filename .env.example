# ── Supabase ──────────────────────────────────────────────────────────
# Project: jpnnzxnvubrosjjcbkmn (Content Box — standalone, NOT the SX project)
NEXT_PUBLIC_SUPABASE_URL=https://jpnnzxnvubrosjjcbkmn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # publishable / anon key
SUPABASE_SERVICE_ROLE_KEY=               # server-only — NEVER expose to the browser

# ── Crypto (Phase 1) ──────────────────────────────────────────────────
# 32-byte keys, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENCRYPTION_KEY=                     # AES-256-GCM key for phone_enc
PHONE_HASH_KEY=                           # HMAC key for phone_hash (lookup)
SESSION_SECRET=                           # signs the session cookie (Phase 2)

# ── OTP (Phase 1) ─────────────────────────────────────────────────────
OTP_TTL_SECONDS=300                       # 5 minutes
OTP_MAX_ATTEMPTS=5
# SMS provider: 'stub' | 'twilio' | 'bird' | 'bird-verify'. 'stub' logs the code to the server
# console (dev). 'bird' is the preferred real provider; 'twilio' is kept as a
# fallback. Both real senders fall back to the stub if their vars are unset, so
# switching is always safe. The chosen provider also carries notification SMS
# (payout / identity texts) when set to 'bird'.
OTP_SENDER=stub
# Diagnostics: when set, a failed OTP send returns the PROVIDER'S OWN reason to the
# browser as well as the log (e.g. "Bird send failed (400): ..."), so a misconfigured
# sender can be fixed without log access. Senders never put the phone number, the
# address or the code in their messages. OFF by default; turn it on to debug, then off.
OTP_DEBUG_ERRORS=
# Email sign-in is a second login channel with the SAME privacy model as phone
# (email_enc + email_hash; other members never see it). Codes go out via Resend
# (RESEND_API_KEY + EMAIL_FROM, further down). If Resend is unset: with
# OTP_SENDER=stub the code is logged with the address MASKED; in any other mode
# email sign-in is refused (HTTP 503) so codes can never leak into logs on a real site.

# ── Bird SMS (real OTP delivery — preferred) ──────────────────────────
# Set OTP_SENDER=bird to activate. API key from the Bird dashboard; it starts with
# bk_eu1_… for the EU region (bk_us1_… for US) and BIRD_REGION must match it.
# BIRD_FROM is your approved sender: an alphanumeric ID such as ContentBox
# (EU-friendly, no number to buy) or a Bird-owned number. All three are required;
# if any is missing the sender falls back to the stub and logs a warning.
BIRD_API_KEY=                              # bk_eu1_...
BIRD_REGION=eu1                            # eu1 | us1 — must match the key's region
BIRD_FROM=ContentBox                       # alphanumeric sender ID or +32... number
# Optional: send the OTP as a stored Bird template instead of free text. Bird ships
# a built-in `bird_otp_verification` template whose variable is `code`. Unset = free
# text (unchanged behaviour). A template picks its own sender + category, so BIRD_FROM
# is then only used for notification SMS.
BIRD_TEMPLATE_SLUG=                        # e.g. bird_otp_verification
BIRD_TEMPLATE_LANGUAGE=                    # e.g. en / nl — omit for the template default
#
# OTP_SENDER=bird-verify switches SMS codes to Bird's managed **Verify** product
# (POST /v1/verify/verifications) instead of sending the SMS ourselves. Bird generates,
# delivers and checks the code. It uses Bird's SHARED senders, so there is NO sender-ID
# registration per country — the gate that blocks a plain send in markets that
# pre-register alphanumeric senders. Needs only BIRD_API_KEY + BIRD_REGION; BIRD_FROM
# is ignored. Trade-off: on a shared sender the code arrives branded "Authifly", not
# Content Box. EMAIL codes are deliberately NOT affected and stay on Resend.

# ── Twilio SMS (real OTP delivery — fallback) ─────────────────────────
# Authenticate with a Standard API Key (SK sid + secret), NOT the Auth Token.
# Set OTP_SENDER=twilio to activate. Need the account SID plus one sender:
# a Messaging Service (recommended) OR a From number.
TWILIO_ACCOUNT_SID=                        # AC...
TWILIO_API_KEY_SID=                        # SK...
TWILIO_API_KEY_SECRET=                     # shown once in the Twilio console
TWILIO_MESSAGING_SERVICE_SID=              # MG... (recommended)
TWILIO_FROM_NUMBER=                        # +32... (used if no Messaging Service)

# ── Admin fingerprint (WebAuthn) ──────────────────────────────────────
# RP_ID = the registrable domain; APP_ORIGIN = the full https origin.
# Production:  RP_ID=content24market.space   APP_ORIGIN=https://content24market.space
# Local dev:   RP_ID=localhost               APP_ORIGIN=http://localhost:3000
RP_ID=content24market.space
APP_ORIGIN=https://content24market.space

# ── Rentals cron ──────────────────────────────────────────────────────
# Secret for the scheduled expiry sweep (/api/cron/expire). Vercel Cron sends it
# as `Authorization: Bearer $CRON_SECRET`. Unset = endpoint disabled.
CRON_SECRET=

# ── Verotel FlexPay (token purchase) ──────────────────────────────────
# Until both are set, purchase returns { configured:false } (dev top-up stays the
# fallback). Configure success/decline URLs in the Verotel panel, NOT here.
# Postback URL: https://content24market.space/api/verotel/webhook
VEROTEL_SHOP_ID=
VEROTEL_SIGNATURE_KEY=

# ── Paystack — M-Pesa (Kenya) token purchase ──────────────────────────
# BUILT BUT NOT LIVE. Do NOT set PAYSTACK_SECRET_KEY in production until the
# Kenya legal check is confirmed green — while unset, /api/wallet/purchase-mpesa
# returns { configured:false } and the M-Pesa rail stays off (dev top-up / Verotel
# remain the paths). Adult content may be illegal in Kenya — get local counsel first.
# Webhook URL to register in the Paystack dashboard:
#   https://content24market.space/api/paystack/webhook
PAYSTACK_SECRET_KEY=                       # sk_live_... / sk_test_...
KES_PER_EUR=145                            # EUR→KES rate used to price a charge; review before go-live

# ── Crypto (NOWPayments) — token purchase ─────────────────────────────
# Adult-friendly, multi-coin hosted checkout + IPN webhook. While BOTH are unset,
# /api/wallet/purchase-crypto returns { configured:false } and the "Pay with crypto"
# button falls back to the dev top-up. To activate: set both, then redeploy.
# Register this IPN callback in the NOWPayments store settings:
#   https://content24market.space/api/wallet/crypto/webhook
NOWPAYMENTS_API_KEY=                        # from the NOWPayments dashboard
NOWPAYMENTS_IPN_SECRET=                     # Store settings → IPN secret (signs the webhook)

# ── Admin assistant (Chat with Claude) ────────────────────────────────
# Operator-only assistant that answers via read-only, PII-free tools. Unset =
# the chat replies with a "not configured" message. ANTHROPIC_MODEL is optional
# (defaults to claude-opus-5) — set a cheaper model id to reduce cost.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Email (Resend) — sign-in codes + notifications ────────────────────
# BOTH are required, together, for either use. See docs/resend-setup.md.
#   unset → email SIGN-IN is refused with a 503 (or, only under OTP_SENDER=stub,
#           the code is logged with the address masked); notification emails are
#           skipped and SMS still works.
# EMAIL_FROM must be a sender Resend will accept:
#   - onboarding@resend.dev — instant, no DNS, but ONLY delivers to the Resend
#     account owner's own address. Smoke test only.
#   - your own domain, once Verified at resend.com/domains. Required for real users.
# An unverified domain fails with 403 validation_error, surfaced in the
# [otp/start] log line as: Email send failed (403): validation_error <message>.
RESEND_API_KEY=                            # re_...
EMAIL_FROM=                                # e.g. Content Box <no-reply@secretxperience.eu>
# Optional. People reply to a no-reply sender regardless of the label; set this and
# those replies reach a mailbox that is read. Unset = no reply_to is sent at all.
EMAIL_REPLY_TO=                            # e.g. support@secretxperience.eu

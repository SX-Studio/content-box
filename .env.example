# ── Supabase ──────────────────────────────────────────────────────────
# Project: jpnnzxnvubrosjjcbkmn (Content Box — standalone, NOT the SX project)
NEXT_PUBLIC_SUPABASE_URL=https://jpnnzxnvubrosjjcbkmn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # publishable / anon key
SUPABASE_SERVICE_ROLE_KEY=               # server-only — NEVER expose to the browser

# ── Crypto (Phase 1) ──────────────────────────────────────────────────
# 32-byte keys, hex-encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENCRYPTION_KEY=                     # AES-256-GCM key for phone_enc
PHONE_HASH_KEY=                           # HMAC key for phone_hash (lookup)
SESSION_SECRET=                           # signs the session cookie (Phase 2)

# ── OTP (Phase 1) ─────────────────────────────────────────────────────
OTP_TTL_SECONDS=300                       # 5 minutes
OTP_MAX_ATTEMPTS=5
# SMS provider. 'stub' logs the code to the server console (dev). Set 'twilio'
# for real SMS — the Twilio sender falls back to the stub if the vars below are
# unset, so switching is always safe.
OTP_SENDER=stub

# ── Twilio SMS (real OTP delivery) ────────────────────────────────────
# Authenticate with a Standard API Key (SK sid + secret), NOT the Auth Token.
# Set OTP_SENDER=twilio to activate. Need the account SID plus one sender:
# a Messaging Service (recommended) OR a From number.
TWILIO_ACCOUNT_SID=                        # AC...
TWILIO_API_KEY_SID=                        # SK...
TWILIO_API_KEY_SECRET=                     # shown once in the Twilio console
TWILIO_MESSAGING_SERVICE_SID=              # MG... (recommended)
TWILIO_FROM_NUMBER=                        # +32... (used if no Messaging Service)

# ── Admin fingerprint (WebAuthn) ──────────────────────────────────────
# RP_ID = the registrable domain; APP_ORIGIN = the full https origin.
# Production:  RP_ID=content24market.space   APP_ORIGIN=https://content24market.space
# Local dev:   RP_ID=localhost               APP_ORIGIN=http://localhost:3000
RP_ID=content24market.space
APP_ORIGIN=https://content24market.space

# ── Rentals cron ──────────────────────────────────────────────────────
# Secret for the scheduled expiry sweep (/api/cron/expire). Vercel Cron sends it
# as `Authorization: Bearer $CRON_SECRET`. Unset = endpoint disabled.
CRON_SECRET=

# ── Verotel FlexPay (token purchase) ──────────────────────────────────
# Until both are set, purchase returns { configured:false } (dev top-up stays the
# fallback). Configure success/decline URLs in the Verotel panel, NOT here.
# Postback URL: https://content24market.space/api/verotel/webhook
VEROTEL_SHOP_ID=
VEROTEL_SIGNATURE_KEY=

# ── Paystack — M-Pesa (Kenya) token purchase ──────────────────────────
# BUILT BUT NOT LIVE. Do NOT set PAYSTACK_SECRET_KEY in production until the
# Kenya legal check is confirmed green — while unset, /api/wallet/purchase-mpesa
# returns { configured:false } and the M-Pesa rail stays off (dev top-up / Verotel
# remain the paths). Adult content may be illegal in Kenya — get local counsel first.
# Webhook URL to register in the Paystack dashboard:
#   https://content24market.space/api/paystack/webhook
PAYSTACK_SECRET_KEY=                       # sk_live_... / sk_test_...
KES_PER_EUR=145                            # EUR→KES rate used to price a charge; review before go-live

# ── Admin assistant (Chat with Claude) ────────────────────────────────
# Operator-only assistant that answers via read-only, PII-free tools. Unset =
# the chat replies with a "not configured" message. ANTHROPIC_MODEL is optional
# (defaults to claude-opus-5) — set a cheaper model id to reduce cost.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ── Email notifications (Resend) ──────────────────────────────────────
# Optional. Both required to send email (e.g. payout decisions) to creators
# who set a contact email. Unset = email notifications are skipped (SMS still
# works). EMAIL_FROM must be a verified sender/domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=                                # e.g. Content Box <no-reply@content24market.space>
